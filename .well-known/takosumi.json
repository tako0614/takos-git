{
  "apiVersion": "takosumi.com/v2.5",
  "kind": "Repository",
  "install": {
    "modules": {
      ".": {
        "inputs": [
          {
            "name": "project_name",
            "source": {
              "kind": "capsule_name"
            },
            "role": "service_name",
            "type": "string",
            "format": "subdomain",
            "label": {
              "ja": "サービス名",
              "en": "Service name"
            }
          },
          {
            "name": "public_subdomain",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "subdomain",
            "label": {
              "ja": "公開サブドメイン",
              "en": "Public subdomain"
            },
            "advanced": true
          },
          {
            "name": "public_url",
            "source": {
              "kind": "user"
            },
            "type": "string",
            "format": "url",
            "required": false,
            "label": {
              "ja": "公開URL",
              "en": "Public URL"
            },
            "helper": {
              "ja": "空欄の場合は利用可能なWorker URLを使います。",
              "en": "Uses an available Worker URL when omitted."
            },
            "placeholder": "https://git.example.com"
          },
          {
            "name": "takosumi_accounts_issuer_url",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "Takosumi Accounts発行者",
              "en": "Takosumi Accounts issuer"
            },
            "advanced": true
          },
          {
            "name": "takosumi_accounts_client_id",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "Takosumi Accountsクライアント",
              "en": "Takosumi Accounts client"
            },
            "advanced": true
          },
          {
            "name": "worker_release_tag",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "Workerリリース",
              "en": "Worker release"
            },
            "advanced": true
          },
          {
            "name": "worker_bundle_url",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "Worker URL",
              "en": "Worker URL"
            },
            "advanced": true
          },
          {
            "name": "worker_bundle_sha256",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "Worker SHA-256",
              "en": "Worker SHA-256"
            },
            "advanced": true
          },
          {
            "name": "takosumi_accounts_url",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "Takosumi Accounts URL",
              "en": "Takosumi Accounts URL"
            },
            "advanced": true
          },
          {
            "name": "takosumi_accounts_redirect_uri",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "Registered callback URI",
              "en": "Registered callback URI"
            },
            "advanced": true
          },
          {
            "name": "app_workspace_id",
            "source": {
              "kind": "workspace_id"
            },
            "type": "string",
            "label": {
              "ja": "現在のWorkspace",
              "en": "Current Workspace"
            }
          },
          {
            "name": "app_capsule_id",
            "source": {
              "kind": "capsule_id"
            },
            "type": "string",
            "label": {
              "ja": "現在のアプリ",
              "en": "Current app"
            }
          },
          {
            "name": "enable_cloudflare_resources",
            "source": {
              "kind": "user"
            },
            "type": "boolean",
            "required": false,
            "label": {
              "ja": "Cloudflareリソースを作成",
              "en": "Create Cloudflare resources"
            },
            "helper": {
              "ja": "Cloudflareへ配置するときは、この設定と「Gitを起動」を有効にします。適用前に作成内容を確認できます。",
              "en": "Enable this and Deploy Git for a Cloudflare deployment. Review the resource plan before applying."
            },
            "advanced": true
          },
          {
            "name": "enable_cloudflare_worker_script",
            "source": {
              "kind": "user"
            },
            "type": "boolean",
            "required": false,
            "label": {
              "ja": "Gitを起動",
              "en": "Deploy Git"
            },
            "helper": {
              "ja": "GitのWorkerを配置します。「Cloudflareリソースを作成」も有効にしてください。",
              "en": "Deploy the Git Worker. Also enable Create Cloudflare resources."
            },
            "advanced": true
          },
          {
            "name": "manage_browser_session",
            "source": {
              "kind": "user"
            },
            "type": "boolean",
            "required": false,
            "label": {
              "ja": "ログイン用の鍵をこのインストールで管理",
              "en": "Manage this installation’s sign-in key"
            },
            "helper": {
              "ja": "新規導入用です。鍵は更新時も保持します。手動で用意した鍵とは併用できません。",
              "en": "For a new installation. The key is retained across updates. Cannot be combined with a manually supplied key."
            },
            "advanced": true
          },
          {
            "name": "enable_metadata",
            "source": {
              "kind": "user"
            },
            "type": "boolean",
            "required": false,
            "label": {
              "ja": "リポジトリ管理を有効にする",
              "en": "Enable repository management"
            },
            "helper": {
              "ja": "リポジトリ一覧・権限管理・Issueなどに必要なデータベースを作成します。適用前に作成内容を確認できます。",
              "en": "Create the database needed for repository lists, access control, and issues. Review the resource plan before applying."
            },
            "advanced": true
          }
        ],
        "requires": [
          {
            "kind": "http.endpoint",
            "deliver": {
              "variables": {
                "url": "public_url",
                "subdomain": "public_subdomain"
              }
            }
          },
          {
            "kind": "identity.oidc",
            "callbackPath": "/api/auth/callback",
            "scopes": [
              "openid",
              "profile",
              "email"
            ],
            "deliver": {
              "variables": {
                "accountsUrl": "takosumi_accounts_url",
                "issuerUrl": "takosumi_accounts_issuer_url",
                "clientId": "takosumi_accounts_client_id",
                "redirectUri": "takosumi_accounts_redirect_uri"
              }
            }
          }
        ],
        "interfaces": [
          {
            "key": "launcher",
            "name": "takos-git.launcher",
            "spec": {
              "type": "interface.ui.surface",
              "version": "1",
              "document": {
                "launcher": true,
                "display": {
                  "title": "Takos Git",
                  "icon": "/icons/takos-git.svg"
                }
              },
              "inputs": {
                "url": {
                  "source": "output",
                  "outputName": "launch_url",
                  "outputType": "url"
                }
              },
              "access": {
                "visibility": "workspace"
              }
            },
            "bindingRequests": [
              {
                "key": "installer",
                "subject": {
                  "source": "installing_principal"
                },
                "permissions": [
                  "ui.open"
                ],
                "delivery": {
                  "type": "none"
                }
              }
            ]
          },
          {
            "key": "git-smart-http",
            "name": "takos-git.smart-http",
            "spec": {
              "type": "source.git.smart_http",
              "version": "1",
              "document": {
                "protocol": "http.git-smart",
                "display": {
                  "title": "Takos Git Smart HTTP"
                }
              },
              "inputs": {
                "endpoint": {
                  "source": "output",
                  "outputName": "api_url",
                  "outputType": "url"
                }
              },
              "access": {
                "visibility": "workspace",
                "resourceUriInput": "endpoint"
              }
            }
          },
          {
            "key": "mcp",
            "name": "takos-git.mcp",
            "spec": {
              "type": "mcp.server",
              "version": "2025-11-25",
              "document": {
                "transport": "streamable-http",
                "display": {
                  "title": "Takos Git"
                }
              },
              "inputs": {
                "endpoint": {
                  "source": "output",
                  "outputName": "mcp_url",
                  "outputType": "url"
                }
              },
              "access": {
                "visibility": "workspace",
                "resourceUriInput": "endpoint"
              }
            },
            "bindingRequests": [
              {
                "key": "installer",
                "subject": {
                  "source": "installing_principal"
                },
                "permissions": [
                  "mcp.invoke"
                ],
                "delivery": {
                  "type": "oauth2"
                }
              }
            ]
          }
        ]
      },
      "deploy/takoform": {
        "inputs": [
          {
            "name": "project_name",
            "source": {
              "kind": "capsule_name"
            },
            "role": "service_name",
            "type": "string",
            "format": "subdomain",
            "label": {
              "ja": "サービス名",
              "en": "Service name"
            }
          },
          {
            "name": "worker_bundle_manifest_digest",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "Worker bundle manifest digest",
              "en": "Worker bundle manifest digest"
            },
            "advanced": true
          },
          {
            "name": "takosumi_accounts_issuer_url",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "Takosumi Accounts発行者",
              "en": "Takosumi Accounts issuer"
            },
            "advanced": true
          },
          {
            "name": "takosumi_accounts_client_id",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "Takosumi Accountsクライアント",
              "en": "Takosumi Accounts client"
            },
            "advanced": true
          },
          {
            "name": "app_workspace_id",
            "source": {
              "kind": "workspace_id"
            },
            "type": "string",
            "label": {
              "ja": "互換Workspace",
              "en": "Compatibility Workspace"
            }
          },
          {
            "name": "app_capsule_id",
            "source": {
              "kind": "capsule_id"
            },
            "type": "string",
            "label": {
              "ja": "現在のアプリ",
              "en": "Current app"
            }
          }
        ],
        "requires": [
          {
            "kind": "identity.oidc",
            "callbackPath": "/api/auth/callback",
            "scopes": [
              "openid",
              "profile",
              "email"
            ],
            "deliver": {
              "variables": {
                "issuerUrl": "takosumi_accounts_issuer_url",
                "clientId": "takosumi_accounts_client_id"
              }
            }
          }
        ],
        "interfaces": [
          {
            "key": "git-smart-http",
            "name": "takos-git.smart-http",
            "spec": {
              "type": "source.git.smart_http",
              "version": "1",
              "document": {
                "protocol": "http.git-smart",
                "display": {
                  "title": "Takos Git Smart HTTP"
                }
              },
              "inputs": {
                "endpoint": {
                  "source": "output",
                  "outputName": "api_url",
                  "outputType": "url"
                }
              },
              "access": {
                "visibility": "workspace",
                "resourceUriInput": "endpoint"
              }
            }
          },
          {
            "key": "mcp",
            "name": "takos-git.mcp",
            "spec": {
              "type": "mcp.server",
              "version": "2025-11-25",
              "document": {
                "transport": "streamable-http",
                "display": {
                  "title": "Takos Git"
                }
              },
              "inputs": {
                "endpoint": {
                  "source": "output",
                  "outputName": "mcp_url",
                  "outputType": "url"
                }
              },
              "access": {
                "visibility": "workspace",
                "resourceUriInput": "endpoint"
              }
            },
            "bindingRequests": [
              {
                "key": "installer",
                "subject": {
                  "source": "installing_principal"
                },
                "permissions": [
                  "mcp.invoke"
                ],
                "delivery": {
                  "type": "oauth2"
                }
              }
            ]
          }
        ]
      },
      "deploy/takoform-v1": {
        "inputs": [
          {
            "name": "project_name",
            "source": {
              "kind": "capsule_name"
            },
            "role": "service_name",
            "type": "string",
            "format": "subdomain",
            "label": {
              "ja": "サービス名",
              "en": "Service name"
            }
          },
          {
            "name": "app_workspace_id",
            "source": {
              "kind": "workspace_id"
            },
            "type": "string",
            "label": {
              "ja": "互換Workspace",
              "en": "Compatibility Workspace"
            }
          },
          {
            "name": "app_capsule_id",
            "source": {
              "kind": "capsule_id"
            },
            "type": "string",
            "label": {
              "ja": "現在のアプリ",
              "en": "Current app"
            }
          }
        ],
        "requires": [
          {
            "kind": "secret.generated",
            "bytes": 32,
            "encoding": "hex",
            "deliver": {
              "bindings": {
                "value": "APP_SESSION_SECRET"
              }
            }
          },
          {
            "kind": "identity.oidc",
            "callbackPath": "/api/auth/callback",
            "scopes": [
              "openid",
              "profile",
              "email"
            ],
            "deliver": {
              "bindings": {
                "issuerUrl": "OIDC_ISSUER_URL",
                "clientId": "OIDC_CLIENT_ID",
                "ownerSubject": "OIDC_OWNER_SUB",
                "redirectUri": "OIDC_REDIRECT_URI"
              }
            }
          }
        ],
        "sourceBuild": {
          "commands": [
            {
              "argv": [
                "bun",
                "install",
                "--frozen-lockfile"
              ]
            },
            {
              "argv": [
                "bun",
                "install",
                "--frozen-lockfile",
                "--cwd",
                "web"
              ]
            },
            {
              "argv": [
                "bun",
                "run",
                "build"
              ]
            },
            {
              "argv": [
                "bun",
                "scripts/prepare-takoform-v1-source.ts"
              ]
            }
          ],
          "outputs": [
            "deploy/takoform-v1/.generated/git-worker.js"
          ]
        },
        "interfaces": [
          {
            "key": "launcher",
            "name": "takos-git.launcher",
            "spec": {
              "type": "interface.ui.surface",
              "version": "1",
              "document": {
                "launcher": true,
                "display": {
                  "title": "Takos Git"
                }
              },
              "inputs": {
                "url": {
                  "source": "output",
                  "outputName": "launch_url",
                  "outputType": "url"
                }
              },
              "access": {
                "visibility": "workspace"
              }
            },
            "bindingRequests": [
              {
                "key": "installer",
                "subject": {
                  "source": "installing_principal"
                },
                "permissions": [
                  "ui.open"
                ],
                "delivery": {
                  "type": "none"
                }
              }
            ]
          },
          {
            "key": "git-smart-http",
            "name": "takos-git.smart-http",
            "spec": {
              "type": "source.git.smart_http",
              "version": "1",
              "document": {
                "protocol": "http.git-smart",
                "display": {
                  "title": "Takos Git Smart HTTP"
                }
              },
              "inputs": {
                "endpoint": {
                  "source": "output",
                  "outputName": "api_url",
                  "outputType": "url"
                }
              },
              "access": {
                "visibility": "workspace",
                "resourceUriInput": "endpoint"
              }
            }
          },
          {
            "key": "mcp",
            "name": "takos-git.mcp",
            "spec": {
              "type": "mcp.server",
              "version": "2025-11-25",
              "document": {
                "transport": "streamable-http",
                "display": {
                  "title": "Takos Git"
                }
              },
              "inputs": {
                "endpoint": {
                  "source": "output",
                  "outputName": "mcp_url",
                  "outputType": "url"
                }
              },
              "access": {
                "visibility": "workspace",
                "resourceUriInput": "endpoint"
              }
            },
            "bindingRequests": [
              {
                "key": "installer",
                "subject": {
                  "source": "installing_principal"
                },
                "permissions": [
                  "mcp.invoke"
                ],
                "delivery": {
                  "type": "oauth2"
                }
              }
            ]
          }
        ]
      }
    }
  }
}
