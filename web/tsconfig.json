{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false
  },
  "include": ["src", "vite.config.ts"],
  // Tests run under Bun (`bun run test:web`), which supplies its own `bun:test`
  // types; matches the worker tsconfig, which also excludes *.test.ts.
  "exclude": ["**/*.test.ts"]
}
